{
    "version": 3,
    "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
    "title": "Big Shoulders",
    "slug": "typography-big-shoulders",
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--big-shoulders)",
            "fontWeight": "400"
        },
        "elements": {
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--big-shoulders)",
                    "fontWeight": "500"
                }
            }
        }
    },
    "settings": {
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "Big Shoulders, sans-serif",
                    "name": "Big Shoulders",
                    "slug": "big-shoulders",
                    "fontFace": [
                        {
                            "fontDisplay": "block",
                            "fontFamily": "Big Shoulders",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "src": [
                                "file:./assets/fonts/big-shoulders/BigShouldersVF.woff2"
                            ]
                        }
                    ]
                }
            ]
        }
    }
}