{
    "version": 3,
    "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
    "title": "Sofia Sans Condensed",
    "slug": "typography-sofia-sans-condensed",
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--sofia-sans-condensed)",
            "fontWeight": "400"
